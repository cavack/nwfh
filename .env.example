ENVIRONMENT=development
LOG_LEVEL=INFO

# Safety invariant: SIGNAL_ONLY. Order placement is disabled and LIVE_TRADING_ENABLED=false is mandatory.
LIVE_TRADING_ENABLED=false
REGISTRY_DB_PATH=/app/data/waterfall_registry.db
BACKTEST_ARTIFACT_HMAC_KEY=

# Experimental signal discovery remains observational and must never place orders.
EXPERIMENTAL_PRETRIGGER_ENABLED=false
EXPERIMENTAL_PRETRIGGER_THRESHOLD=45.0

# Read-only execution evidence collection.
LBANK_EXECUTION_SHADOW_ENABLED=false
LBANK_EXECUTION_SHADOW_BATCH_SIZE=8
LBANK_EXECUTION_SHADOW_INTERVAL_SECONDS=60
LBANK_EXECUTION_SHADOW_SUCCESS_RECHECK_SECONDS=1800
LBANK_EXECUTION_SHADOW_FAILURE_RECHECK_SECONDS=600

# Optional Telegram command bot credentials. Production deployment enables
# durable STRICT signal delivery with a release-scoped cutover timestamp.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SIGNAL_DELIVERY_ENABLED=false
# Production deployment sets this to the release UTC Unix timestamp:
# TELEGRAM_SIGNAL_DELIVERY_CUTOVER_AT=1787683200

# Optional advisory and market-data providers.
# TypeSafe System One (Jev) advisory — observational only, never gates a signal.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=jev-latest
TYPESAFE_TIMEOUT_SECONDS=30
COINGLASS_API_KEY=
DEXSCREENER_ENABLED=false
DEXSCREENER_TOKEN_MAP_JSON={}
ETHERSCAN_API_KEY=
SOLSCAN_API_KEY=
