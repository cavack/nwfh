    "@types/node": "^26.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.6.1",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "postcss": "^8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
